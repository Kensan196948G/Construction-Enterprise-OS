# ─────────────────────────────────────────────────────────────────────────────
# apps/web — Frontend environment variables (example)
# Copy to `.env.local` and adjust for your environment. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API gateway the web app calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Auth bypass (DEVELOPMENT ONLY) ───────────────────────────────────────────
# Disables the dashboard auth guard so you can open /dashboard without logging
# in. SECURITY: keep this UNSET (or anything other than "true") in production
# and staging — the guard is enforced by default and only the exact value
# "true" turns it off (fail closed).
#
#   NEXT_PUBLIC_AUTH_BYPASS=true   # local demo only
NEXT_PUBLIC_AUTH_BYPASS=

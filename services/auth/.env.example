# Environment variables for CEO-OS Auth Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ceoos:ceoos_dev@localhost:5432/ceoos

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (本番では必ず強力な鍵を設定すること)
JWT_PRIVATE_KEY=dev-only-do-not-use-in-production
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]

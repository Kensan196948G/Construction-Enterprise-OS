# Environment variables for CEO-OS Workflow Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ceoos:ceoos_dev@localhost:5432/ceoos

# JWT (本番では必ず強力な鍵を設定すること)
JWT_SECRET_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]

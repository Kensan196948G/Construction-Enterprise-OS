# Environment variables for CEO-OS IoT Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ceoos:ceoos_dev@localhost:5432/ceoos

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# JWT (本番では必ず強力な鍵を設定すること)
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256

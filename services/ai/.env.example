# Environment variables for CEO-OS AI Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8006
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ceoos:ceoos_dev@localhost:5432/ceoos

# LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_DEFAULT_MODEL=gpt-4
LLM_EMBEDDING_MODEL=text-embedding-ada-002

# JWT (Auth Service 発行トークン検証用)
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]
